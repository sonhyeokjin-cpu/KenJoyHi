        #plot-area.show-for-plot {
            display: grid !important;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(2, 1fr);
            width: 100vw;
            height: 100vh;
            gap: 8px;
            overflow: hidden;
        }
        .chart-container {
            width: 100%;
